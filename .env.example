# ============================================================================
# 词径记 · 环境变量样例
# ============================================================================
# 用法：复制成 `.env.local`（同目录），把 Key 填进去。
#   cp .env.example .env.local
#
# ⚠️ `.env.local` 里是**真钱**，`.gitignore` 已经挡住它 —— 永远不要提交。
# ⚠️ 这些变量**只在服务端**可用（`app/api/ai/route.ts` 那条链路）。
#    不要加 `NEXT_PUBLIC_` 前缀 —— 加了就会被内联进浏览器包，等于把 Key 公开。
#
# 阶段 0 只需要一个 AI 任务：`example_personalized`（按兴趣域写例句）。
# 全都不填也能跑：AI 那两档会被跳过，例句自动落到模板句，学习页照常可用。
#
# ── 谁会先被调用？（2026-09-25 定案：DeepSeek 打头）──────────
#   · 例句（cheap 档）        ：DeepSeek → GLM 免费档 → 模板句
#   · 要动脑子的活（standard 档）：DeepSeek → GLM → 模板句
#   「哪一档排谁在前」写在 `lib/ai/config.ts` 的两张表里，**不在这个文件里**。
#
#   中途试过"例句这种轻活让 GLM 免费档打头"想省钱，当天就被线上实测推翻：
#   免费档并发只有 1，工作日白天几乎必挂 → 每次请求都先白等一轮失败。
#   结论是**稳定优先**，不为了省这点钱牺牲可用性。
# ============================================================================

# ------------------------------------------- 主力：DeepSeek（付费）
# 拿 Key：platform.deepseek.com → API Keys（要实名 + 至少充 ¥10）
# ⚠️ 余额为 0 时它会返回 402，网关会**把它冷却 5 分钟**再试
#    （否则每次请求都要在它身上白等一轮 —— 线上实测就是这样）。
# 成本量级：一句例句约 0.001~0.002 元，充 ¥10 够写几千句。
DEEPSEEK_API_KEY=
# 模型名。2026-09 起 DeepSeek 的规范名是 `deepseek-flash`
# （旧名 `deepseek-v4-flash` 仍被接受，请求由同名模型承接、按 Flash 价计费）。
AI_MODEL_DEEPSEEK=deepseek-flash
AI_BASE_DEEPSEEK=https://api.deepseek.com

# ------------------------------------ 兜底：智谱 GLM（免费档）
# 拿 Key：open.bigmodel.cn → API Keys（Flash 档有免费额度）
# ⚠️ 免费档**并发只有 1**、速度不稳，所以它排在 DeepSeek 后面垫底，
#    撞上限流（429）时会立刻换档，不在同一档上硬碰 —— 见 `lib/ai/retry.ts`。
#    它的单次超时也单独设得更短（默认 4 秒），免得被卡住时把时间耗光。
GLM_API_KEY=
# 想让 GLM 更稳，就换成付费档 `glm-5.3-flash`（0.8 / 2.8 元每百万 token，限时五折）。
# 只改这一行，代码不用动。
# ⚠️ 别填 `glm-4.7-flashX` —— 那是国际站（Z.ai）的型号，国内站价格页上根本没有这个。
AI_MODEL_GLM=glm-4.7-flash
AI_BASE_GLM=https://open.bigmodel.cn/api/paas/v4

# ------------------------------------------------------------ 超时与总预算
# 每一档的单次超时**是分开算的**，优先级从高到低：
#   ① AI_TIMEOUT_<档名>_MS（只改这一档）
#   ② 内置默认：**免费档 4000 毫秒**、付费档 AI_TIMEOUT_MS（不填 12000）
#
# 为什么免费档要更短：它并发只有 1，高峰期限流时不是报错、而是把我们挂着，
# 于是每次请求都要白等满 12 秒才肯换档 —— 而它正常只要 1~3 秒。超过 4 秒基本就是卡住了。
#
# ⚠️ 免费档**不受 `AI_TIMEOUT_MS` 影响**，这是刻意的：这个名字比"免费档特殊待遇"出现得早，
#    很多环境里已经填着 12000，若让它覆盖免费档，就等于"修好的毛病被一条旧配置悄悄改回去"。
#    要给免费档改超时，请用下面的 AI_TIMEOUT_GLM_MS 明说。
AI_TIMEOUT_DEEPSEEK_MS=12000
AI_TIMEOUT_GLM_MS=4000

# 付费档的默认超时（毫秒）。不填就是 12000。上限 60000。
# AI_TIMEOUT_MS=12000

# **整条链**的总预算（毫秒）。不填默认 20000，上限 120000，
# 且**不得小于"最长的那个单档超时"**（否则第一档都开不了）。
# 没有它，最坏情况是「2 档 × 2 次 × 12 秒 = 48 秒」，用户早就走了。
AI_TOTAL_BUDGET_MS=20000

# 失败后**重试前先等多久**（毫秒）。不填默认 1200。
# ⚠️ 千万别调成 0：免费档并发只有 1，而"超时"只是**我们这边不等了**、
#    对方服务器上那次还在跑。立刻重发就会一头撞上它 → 429。
AI_RETRY_BACKOFF_MS=1200

# 某一档"明确死掉"（余额不足 402 / Key 不对 401）后，冻结多久不再试它（毫秒）。
# 不填默认 300000（5 分钟）。它存在进程内存里，实例重启就清空 ——
# 只是省时间，不影响正确性（失效了最多是多试一次）。
AI_COOLDOWN_MS=300000

# ============================================================================
# 想在没有 Key 的情况下验 AI 通路？用本地假模型
# ============================================================================
# 它按 OpenAI 格式应答，能把「请求拼装 → 解析 → 分档路由 → 降级 → 退避重试 → 记账」
# 整条链路原样走一遍，还会打印 system 提示词的指纹
# （指纹变了 = 缓存会失效，这个 bug 不报错、只涨账单）。
#
#   终端 A：node scripts/mock-ai-server.mjs
#   终端 B：npm run dev
#
# 然后把下面四行取消注释填进 `.env.local`（Key 随便写个非空值，假服务不校验）。
# **两家都指向假服务**，"分档路由"才能整条走一遍（否则只看得到第一档）：
#
# DEEPSEEK_API_KEY=mock-key
# AI_BASE_DEEPSEEK=http://127.0.0.1:8787
# GLM_API_KEY=mock-key
# AI_BASE_GLM=http://127.0.0.1:8787
#
# 想验降级链，改启动参数（MOCK_MODE=500 / 429 / 402 / garbage / slow / empty）。
# 想模拟"这一家坏、那一家好"，再起一个实例换个端口，然后覆盖环境变量启动站点：
#   MOCK_PORT=8790 MOCK_MODE=429 node scripts/mock-ai-server.mjs
#   AI_BASE_GLM=http://127.0.0.1:8790 npm start
# （进程环境优先于 .env.local，所以不用去改上面那个文件。）

# ============================================================================
# 想加第三家 AI 供应商？（这是预留好的扩展点）
# ============================================================================
# 前提：对方要提供 **OpenAI 兼容**的 `/chat/completions`（否则 `lib/ai/provider.ts` 那份
# 调用代码要改）。满足的话：
#   ① 在 `lib/ai/config.ts` 的 `PROVIDERS` 里加一项（id + 三个环境变量名 + 默认模型/端点）；
#   ② 在 `TIER_ORDER` 里给相应档位排个位置（谁在前谁就先用）。
# 业务代码一行都不用动 —— 这就是"模型名只出现在一个文件里"的价值。
