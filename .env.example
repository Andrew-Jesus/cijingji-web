# ============================================================================
# 词径记 · 环境变量样例
# ============================================================================
# 用法：复制成 `.env.local`（同目录），把 Key 填进去。
#   cp .env.example .env.local
#
# ⚠️ `.env.local` 里是**真钱**，`.gitignore` 已经挡住它 —— 永远不要提交。
# ⚠️ 这些变量**只在服务端**可用（`app/api/ai/route.ts` 那条链路）。
#    不要加 `NEXT_PUBLIC_` 前缀 —— 加了就会被内联进浏览器包，等于把 Key 公开。
#
# 阶段 0 只需要一个 AI 任务：`example_personalized`（按兴趣域写例句）。
# 全都不填也能跑：AI 那两档会被跳过，例句自动落到模板句，学习页照常可用。
#
# ── 谁会先被调用？（2026-09-25 定案：DeepSeek 打头）──────────
#   · 例句（cheap 档）        ：DeepSeek → GLM → 模板句
#   · 要动脑子的活（standard 档）：DeepSeek → GLM → 模板句
#   「哪一档排谁在前」写在 `lib/ai/config.ts` 的两张表里，**不在这个文件里**。
#
#   中途试过"例句这种轻活让 GLM 免费档打头"想省钱，当天就被线上实测推翻：
#   免费档并发只有 1，工作日白天几乎必挂 → 每次请求都先白等一轮失败。
#   结论是**稳定优先**，不为了省这点钱牺牲可用性。
#
#   2026-09-29 更新：**垫底档也换成付费的了** —— 免费档在线上实测
#   **14 次尝试 0 次成功**（白天必撞 429），留一个"几乎必然失败"的兜底没有意义。
#   同时主力那一档**关掉了"思考"**（下一段详述）。这两件事合起来才是正解：
#   **主力自己稳，垫底才轮不到上场** —— 靠垫底兜底永远是下策。
# ============================================================================

# ------------------------------------------- 主力：DeepSeek（付费）
# 拿 Key：platform.deepseek.com → API Keys（要实名 + 至少充 ¥10）
# ⚠️ 余额为 0 时它会返回 402，网关会**把它冷却 5 分钟**再试
#    （否则每次请求都要在它身上白等一轮 —— 线上实测就是这样）。
#
# ── 「思考」必须关掉（2026-09-29 的一课，**别删这段**）──────────
# 这一代 flash 档**默认先"想"再答**，而思考 token 和正文**共用同一个输出预算**、
# 还按输出价计费。线上实测的代价（云端账目 29 条）：
#   · 成功率只有 **53%** —— 一半请求的正文被思考挤没了，接口却返回 200 不报错；
#   · 成功那几发的输出 token 打在 **180**（撞满上限），正常只要 35~45；
#   · 撞满那发 ¥0.001226、正常那发 ¥0.000383 → **贵 3 倍**。
# 代码对 DeepSeek 发的是 `reasoning_effort: "none"`（**彻底关掉**）。
# 预期：成功率回到正常、输出 token 降约 4 倍、延迟降到 1 秒内。
DEEPSEEK_API_KEY=
# 模型名。2026-09 起 DeepSeek 的规范名是 `deepseek-flash`
# （旧名 `deepseek-v4-flash` 仍被接受，请求由同名模型承接、按 Flash 价计费）。
AI_MODEL_DEEPSEEK=deepseek-flash
AI_BASE_DEEPSEEK=https://api.deepseek.com

# ------------------------------------ 兜底：智谱 GLM（**付费档**）
# 拿 Key + 开通：open.bigmodel.cn
# 2026-09-29 起这里填的是**付费档 `glm-5.3-flash`**，不再是免费档。
# 换掉免费档的原因见上一段：**并发只有 1**，线上 14 次尝试 0 次成功。
# 价格 0.8 / 2.8 元每百万 token（缓存命中 0.23）—— 比 DeepSeek 的普通输入还便宜。
GLM_API_KEY=
# ⚠️ **这一档的"思考"关不掉**：GLM-5.3 系列的 `thinking.type` 只认 `enabled`，
#    传 `disabled` 会直接报错。所以代码只发 `reasoning_effort: "low"` 压一压，
#    并给它单独配了**更大的输出预算**（2048）—— 否则思考链把预算吃光、正文返回空
#    （就是 DeepSeek 刚踩的那个坑，见 `lib/ai/config.ts` 的「思考模式」一节）。
# ⚠️ 别填 `glm-4.7-flashX` —— 那是国际站（Z.ai）的型号，国内站价格页上根本没有这个。
AI_MODEL_GLM=glm-5.3-flash
AI_BASE_GLM=https://open.bigmodel.cn/api/paas/v4

# ------------------------------------------------------------ 超时与总预算
# 每一档的单次超时**是分开算的**，优先级从高到低：
#   ① AI_TIMEOUT_<档名>_MS（只改这一档）
#   ② 内置默认：**免费档 4000 毫秒**、付费档 AI_TIMEOUT_MS（不填 12000）
#
# ⚠️ 当前链上两档**都是付费档** → 都走 12000。"免费档 4000 毫秒"这套机制还留着
#    （将来再加免费档时自动生效），但**现在没有实例**，所以下面两行都是 12000。
#    这条规则对应的分支仍有单测覆盖（见 `config.test.ts`），不是死代码。
#
# ⚠️ 免费档**不受 `AI_TIMEOUT_MS` 影响**，这是刻意的：这个名字比"免费档特殊待遇"出现得早，
#    很多环境里已经填着 12000，若让它覆盖免费档，就等于"修好的毛病被一条旧配置悄悄改回去"。
AI_TIMEOUT_DEEPSEEK_MS=12000
AI_TIMEOUT_GLM_MS=12000

# 付费档的默认超时（毫秒）。不填就是 12000。上限 60000。
# AI_TIMEOUT_MS=12000

# **整条链**的总预算（毫秒）。不填默认 20000，上限 120000，
# 且**不得小于"最长的那个单档超时"**（否则第一档都开不了）。
# 没有它，最坏情况是「2 档 × 2 次 × 12 秒 = 48 秒」，用户早就走了。
AI_TOTAL_BUDGET_MS=20000

# 失败后**重试前先等多久**（毫秒）。不填默认 1200。
# ⚠️ 千万别调成 0：只要对方限流凶，"超时"就只是**我们这边不等了**、
#    对方服务器上那次还在跑。立刻重发就会一头撞上它 → 429。
#    （这条规则最初是为"免费档并发 1"写的，但对限流普遍成立。）
AI_RETRY_BACKOFF_MS=1200

# 某一档"明确死掉"（余额不足 402 / Key 不对 401）后，冻结多久不再试它（毫秒）。
# 不填默认 300000（5 分钟）。它存在进程内存里，实例重启就清空 ——
# 只是省时间，不影响正确性（失效了最多是多试一次）。
AI_COOLDOWN_MS=300000

# ============================================================================
# 想在没有 Key 的情况下验 AI 通路？用本地假模型
# ============================================================================
# 它按 OpenAI 格式应答，能把「请求拼装 → 解析 → 分档路由 → 降级 → 退避重试 → 记账」
# 整条链路原样走一遍，还会打印 system 提示词的指纹
# （指纹变了 = 缓存会失效，这个 bug 不报错、只涨账单）。
#
#   终端 A：node scripts/mock-ai-server.mjs
#   终端 B：npm run dev
#
# 然后把下面四行取消注释填进 `.env.local`（Key 随便写个非空值，假服务不校验）。
# **两家都指向假服务**，"分档路由"才能整条走一遍（否则只看得到第一档）：
#
# DEEPSEEK_API_KEY=mock-key
# AI_BASE_DEEPSEEK=http://127.0.0.1:8787
# GLM_API_KEY=mock-key
# AI_BASE_GLM=http://127.0.0.1:8787
#
# 想验降级链，改启动参数（MOCK_MODE=500 / 429 / 402 / garbage / slow / empty）。
# 想模拟"这一家坏、那一家好"，再起一个实例换个端口，然后覆盖环境变量启动站点：
#   MOCK_PORT=8790 MOCK_MODE=429 node scripts/mock-ai-server.mjs
#   AI_BASE_GLM=http://127.0.0.1:8790 npm start
# （进程环境优先于 .env.local，所以不用去改上面那个文件。）

# ============================================================================
# 想加第三家 AI 供应商？（这是预留好的扩展点）
# ============================================================================
# 前提：对方要提供 **OpenAI 兼容**的 `/chat/completions`（否则 `lib/ai/provider.ts` 那份
# 调用代码要改）。满足的话：
#   ① 在 `lib/ai/config.ts` 的 `PROVIDERS` 里加一项（id + 三个环境变量名 + 默认模型/端点）；
#   ② 在 `TIER_ORDER` 里给相应档位排个位置（谁在前谁就先用）。
# 业务代码一行都不用动 —— 这就是"模型名只出现在一个文件里"的价值。

# ============================================================================
# 阶段 1：账号与跨设备同步（Supabase）
# ============================================================================
# 全都不填也能跑：应用自动进入「纯本地模式」—— 数据存在这台设备上，照常背单词，
# 只是换设备接不上；登录页会显示一句说明，而不是一个登不进去的表单。
# 判断口径全项目只有一处：`lib/supabase/env.ts` 的 `isSupabaseConfigured()`。
#
# ── 从后台哪儿抄？──────────────────────────────────────────────
# Supabase 后台 → 左下角 **Project Settings** → **API Keys**
# （也可以点项目首页的 **Connect** 按钮，那里直接给一段完整接入片段）
#
# ⚠️ 2026 年新老名字不一样，**别抄错页签**：
#     新（推荐）：`Publishable and secret API keys` 页签
#     旧（兼容）：`Legacy API Keys` 页签
#   官方正在废弃旧名字：**2025-11 之后新建的项目只有新名字的 key**，
#   旧名字 2026 年底删除。代码里新旧都认，但建议一律用新的。

# --------------------------------- 可公开的（会进浏览器代码，**这是设计如此**）
# 项目地址，形如 https://abcdefgh.supabase.co（后台首页的 Project URL）
NEXT_PUBLIC_SUPABASE_URL=

# 可公开的那把：新名字叫 **Publishable key**，长得像 `sb_publishable_xxxxx`
# （旧名字叫 anon key，是一长串以 `eyJ` 开头的 JWT。抄哪把都不算错，但别抄混）
#
# 为什么它敢公开：它权限低到只能碰 RLS 允许的东西。
# **真正拦数据的是数据库里那条 RLS 策略，不是这把 key。**
# 反过来也成立：表上没开 RLS，这把 key 就等于把门敞着
# —— 所以建表 SQL 里 RLS 是必写的，不是可选项。
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# --------------------------------- 绝不能公开的（只在服务端读，且**不带 NEXT_PUBLIC_**）
# 新名字叫 **Secret key**，长得像 `sb_secret_xxxxx`（旧名字叫 service_role key）。
#
# ⚠️ 这把是**万能钥匙**：绕过 RLS，能读写整个库。
#    · 绝不加 `NEXT_PUBLIC_` 前缀 —— 加了会被打进浏览器代码，等于公开
#    · 绝不发到群里 / 截图里 / 提交进 git（`.gitignore` 已挡住 `.env.local`）
#    · B1、B2 都用不到它，**B3（AI 记账上云）才需要**
#
# 泄漏核对（阶段 1 新增的第 3 条闸门，接在原有的 `mock-key` 那条后面）：
#   npm run build && grep -rl "<这把 key 的前 20 个字符>" .next/static   → 必须**没有任何输出**
SUPABASE_SECRET_KEY=
