# ============================================================================
# 词径记 · 环境变量样例
# ============================================================================
# 用法：复制成 `.env.local`（同目录），把 Key 填进去。
#   cp .env.example .env.local
#
# ⚠️ `.env.local` 里是**真钱**，`.gitignore` 已经挡住它 —— 永远不要提交。
# ⚠️ 这些变量**只在服务端**可用（`app/api/ai/route.ts` 那条链路）。
#    不要加 `NEXT_PUBLIC_` 前缀 —— 加了就会被内联进浏览器包，等于把 Key 公开。
#
# 阶段 0 只需要一个 AI 任务：`example_personalized`（按兴趣域写例句）。
# 全都不填也能跑：AI 那两档会被跳过，例句自动落到模板句，学习页照常可用。
# ============================================================================

# ---------------------------------------------------------------- 主力：DeepSeek
# 拿 Key：platform.deepseek.com → API Keys（要实名 + 至少充 ¥10）
DEEPSEEK_API_KEY=

# 模型名。2026-09 起 DeepSeek 的规范名是 `deepseek-flash`
# （旧名 `deepseek-v4-flash` 仍被接受，请求由同名模型承接、按 Flash 价计费）。
# ⚠️ 这个默认值与 `lib/ai/config.ts` 里的 `DEFAULT_MODEL_PRIMARY` 是同一份，
#    改的时候两边一起改（这里只是给人看的说明，代码不读它）。
AI_MODEL_PRIMARY=deepseek-flash
AI_BASE_PRIMARY=https://api.deepseek.com

# ---------------------------------------------------------- 兜底：智谱 GLM（免费）
# 拿 Key：open.bigmodel.cn → API Keys（有免费额度的 Flash 档）
GLM_API_KEY=

AI_MODEL_FALLBACK=glm-4.7-flash
AI_BASE_FALLBACK=https://open.bigmodel.cn/api/paas/v4

# ---------------------------------------------------------------- 超时
# 单档超时（毫秒）。不填默认 12000，上限 60000。
# 例句只有一两句话，正常 1~3 秒；超过 12 秒用户已经不耐烦了，换下一档比继续等更快。
AI_TIMEOUT_MS=12000

# ============================================================================
# 想在没有 Key 的情况下验 AI 通路？用本地假模型
# ============================================================================
# 它按 OpenAI 格式应答，能把「请求拼装 → 解析 → 降级 → 记账」整条链路原样走一遍，
# 还会打印 system 提示词的指纹（指纹变了 = 缓存会失效，这个 bug 不报错、只涨账单）。
#
#   终端 A：node scripts/mock-ai-server.mjs
#   终端 B：npm run dev
#
# 然后把下面四行取消注释填进 `.env.local`（Key 随便写个非空值，假服务不校验）：
#
# DEEPSEEK_API_KEY=mock-key
# AI_MODEL_PRIMARY=mock-flash
# AI_BASE_PRIMARY=http://127.0.0.1:8787
# GLM_API_KEY=
#
# 想验降级链，改 `scripts/mock-ai-server.mjs` 的启动参数（MOCK_MODE=500 / garbage / slow / empty）。
